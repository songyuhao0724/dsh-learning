{
  "name": "@dsh-learning/feeds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "外国免费信源雷达：RSS/Atom 抓取 → 本地 SQLite 累积 → 关键词检索，不依赖学校订阅",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
