{
  "name": "@dsh-learning/scholar",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "本地文献索引与带页码引用的检索：Zotero 只读导入 + FTS5 中文检索",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dsh-scholar": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "unpdf": "1.9.1"
  }
}
