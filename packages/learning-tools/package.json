{
  "name": "@dsh-learning/learning-tools",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "把 scholar / carsi-router / career 三个库暴露成 DSH 工具：文献索引检索、可得性路由、检索式、职业画像与四年计划",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@dsh-learning/bio-data": "workspace:*",
    "@dsh-learning/career": "workspace:*",
    "@dsh-learning/carsi-router": "workspace:*",
    "@dsh-learning/onboarding": "workspace:*",
    "@dsh-learning/paper-radar": "workspace:*",
    "@dsh-learning/scholar": "workspace:*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
